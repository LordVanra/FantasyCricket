{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-cricket",
  "account_id": "449af3a7cdd1c99bfbe97b5893d1648c",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fantasy-cricket",
    "database_id": "595063bf-f558-418b-a412-b641a45d4554",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "APP_ORIGINS": "https://fantasycricketgame.vercel.app"
  },
  "ratelimits": [{
    "name": "AUTH_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }]
}
